# Runtime
CORE_HOST=prompt.example.com
SERVER_CORE_HOST=https://prompt.example.com
SERVER_IMAGE_TAG=latest
CLIENT_IMAGE_TAG=latest

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=intro_course
DB_USER=postgres
DB_PASSWORD=postgres

# Auth / external integrations
KEYCLOAK_HOST=https://keycloak.example.com
KEYCLOAK_REALM_NAME=prompt
KEYCLOAK_AUTHORIZED_PARTY=prompt-client
KEYCLOAK_CLIENT_ID=prompt-client
GITLAB_ACCESS_TOKEN=
# GitLab project ID of the teaching-material repo (contains student_repo_template/)
GITLAB_TEACHING_MATERIAL_PROJECT_ID=

# Audit log (optional; off unless core has audit logging enabled)
AUDIT_ENABLED=
# This deployment's own ingest key. Must match the intro-course entry in core's
# AUDIT_INGEST_KEYS. Without it the middleware is a no-op and nothing is reported.
AUDIT_INGEST_KEY=

# Monitoring
SENTRY_DSN=

# Legacy aliases from prompt2 migration (optional)
DB_HOST_INTRO_COURSE=localhost
DB_PORT_INTRO_COURSE=5433
SENTRY_DSN_INTRO_COURSE=
