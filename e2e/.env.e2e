# ============================================================================
# Environment for the E2E docker-compose stack (docker-compose.e2e.yml).
#
# These are TEST-ONLY credentials for an ephemeral, throwaway stack. They are
# committed on purpose so `make test-e2e` works out of the box, locally and in
# CI, with zero setup. Do NOT put real secrets here.
# ============================================================================

ENVIRONMENT=development
DEBUG=true
SERVER_ADDRESS=0.0.0.0:8080
SSL_MODE=disable

# Tag for the prebuilt PROMPT core images pulled from ghcr.io. `latest` tracks the
# newest core release, so integration drift with core surfaces immediately. Pin a
# release tag (e.g. v2.10.1) here if an unrelated core release makes CI noisy.
CORE_IMAGE_TAG=latest

# Service-name URLs on the compose network (the containerized runner's browser
# resolves these via Docker DNS). CORE_HOST is the browser origin used for the
# servers' CORS allow-list; CORE_API_HOST is the API base baked into the core
# client's env.js.
CORE_HOST=http://client-core
CORE_API_HOST=http://server-core:8080

# Host ports, published only so the stack can be inspected by hand and so
# Playwright can be run straight from the host. Deliberately offset from the
# prompt2 e2e stack's 4000 / 18090 / 18081 so both can run at the same time; the
# realm lists these origins as well. The containerized runner never uses them.
CLIENT_PORT=4100
CORE_API_PORT=18190
KEYCLOAK_PORT=18181
# Core URL used by the intro-course server (prompt-sdk) for the is_student auth
# round-trip and for participation lookups.
SERVER_CORE_HOST=http://server-core:8080

CHAIR_NAME_SHORT=AET
CHAIR_NAME_LONG=Applied Education Technologies
GITHUB_SHA=e2e
GITHUB_REF=e2e
SERVER_CORE_IMAGE_TAG=e2e
SERVER_IMAGE_TAG=e2e

# ─── Core database ──────────────────────────────────────────────────────────
DB_CORE_HOST=db
DB_CORE_PORT=5432
DB_CORE_NAME=prompt
DB_CORE_USER=prompt-postgres
DB_CORE_PASSWORD=prompt-postgres

# ─── Intro course database ──────────────────────────────────────────────────
DB_INTRO_COURSE_HOST=db-intro-course
DB_INTRO_COURSE_PORT=5432
DB_INTRO_COURSE_NAME=prompt
DB_INTRO_COURSE_USER=prompt-postgres
DB_INTRO_COURSE_PASSWORD=prompt-postgres

# ─── Keycloak ───────────────────────────────────────────────────────────────
KEYCLOAK_DB_HOST=keycloak-db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

KEYCLOAK_HOST=http://keycloak:8080
KEYCLOAK_REALM_NAME=prompt
KEYCLOAK_CLIENT_ID=prompt-server
# The committed realm stores this literal value as the prompt-server secret.
KEYCLOAK_CLIENT_SECRET=**********
KEYCLOAK_ID_OF_CLIENT=a584ca61-fa83-4e95-98b6-c5f3157ae4b4
KEYCLOAK_AUTHORIZED_PARTY=prompt-client
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Micro-frontend hosts (referenced by the core client's env.js) ──────────
# Empty = same-origin: the intro-course component's API calls go to the browser
# origin (client-core) and are proxied to the intro-course server by
# e2e/nginx/client-core.conf.
INTRO_COURSE_HOST=

# ─── GitLab (deliberately unset) ────────────────────────────────────────────
# Without a token the intro-course server's GitLab client stays nil and the
# repo-setup / peer-sync endpoints fail by design. The specs assert those
# failures instead of talking to a real GitLab.
GITLAB_ACCESS_TOKEN=
GITLAB_TEACHING_MATERIAL_PROJECT_ID=

# ─── S3 (SeaweedFS) ─────────────────────────────────────────────────────────
# Not used by the intro course itself, but core hard-fails at boot if neither the
# prompt-files nor the prompt-privacy-exports bucket is reachable.
S3_BUCKET=prompt-files
S3_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_FORCE_PATH_STYLE=true
MAX_FILE_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/gif,application/zip,text/plain
